{
  "name": "vertactics",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @vertactics/editor dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @vertactics/editor test",
    "test:e2e": "pnpm --filter @vertactics/editor test:e2e",
    "build": "node scripts/build.mjs",
    "preview": "pnpm --filter @vertactics/editor preview",
    "dev:landing": "pnpm --filter @vertactics/landing dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/three": "0.184.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript-eslint": "8.72.2"
  }
}
